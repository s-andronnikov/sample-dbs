-- Drop the table if it exists
BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE Period';
EXCEPTION
    WHEN OTHERS THEN
        IF SQLCODE != -942 THEN
            RAISE;
        END IF;
END;
/

-- Create the Period table
CREATE TABLE Period (
    id NUMBER GENERATED BY DEFAULT AS IDENTITY NOT NULL, -- Auto-increment integer
    name VARCHAR2(50) NOT NULL,
    start_date DATE,
    end_date DATE,
    type VARCHAR2(50) NOT NULL,
    CONSTRAINT pk_period PRIMARY KEY (id) -- Primary key on id
);

-- Create an index on the "type" column
CREATE INDEX ix_period_type ON Period (type);

-- Insert values into the Period table (id will auto-increment)
INSERT INTO Period (name, start_date, end_date, type) VALUES
